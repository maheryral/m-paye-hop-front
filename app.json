{
  "expo": {
    "name": "M'Paye",
    "slug": "monpayeapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "monpaye",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monpaye.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.monpaye.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "M'Paye utilise votre position pour sécuriser vos connexions (détection de localisation des connexions) et le service taxi-brousse."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "M'Paye utilise la caméra pour la vérification de votre visage (KYC)."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
