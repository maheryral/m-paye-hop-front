{
  "info": {
    "name": "M'Paye - Taxi-Brousse (seed + user flow)",
    "description": "Crée la chaîne complète de données (gare → coop → classe → voiture → chauffeur → voyage) puis teste le flow user (recherche → seat map → réservation → paiement).\n\nCommencer par le request 'Login' pour remplir le token automatiquement.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://192.168.1.12:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "gareId", "value": "", "type": "string" },
    { "key": "coopId", "value": "", "type": "string" },
    { "key": "classeId", "value": "", "type": "string" },
    { "key": "voitureId", "value": "", "type": "string" },
    { "key": "chauffeurId", "value": "", "type": "string" },
    { "key": "voyageId", "value": "", "type": "string" },
    { "key": "reservationId", "value": "", "type": "string" },
    { "key": "userEmail", "value": "ton-email@test.com", "type": "string" },
    { "key": "userPassword", "value": "ton-mot-de-passe", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Login (récupère le token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.accessToken) {",
              "  pm.collectionVariables.set('accessToken', json.accessToken);",
              "  console.log('✅ Token sauvegardé');",
              "} else {",
              "  console.error('❌ Pas de token dans la réponse:', JSON.stringify(json));",
              "}",
              "pm.test('Status 200 ou 201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "2. Créer Gare Routière",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('gareId', json.id);",
              "  console.log('✅ gareId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Gare d'Ambodivona\",\n  \"localisation\": \"Ambodivona, Antananarivo\",\n  \"telephone\": \"0341234567\",\n  \"capaciteQuotidienne\": 500,\n  \"horaireOuverture\": \"05:00\",\n  \"horaireFermeture\": \"20:00\",\n  \"latitude\": -18.9098,\n  \"longitude\": 47.5219\n}"
        },
        "url": { "raw": "{{baseUrl}}/gares-routieres", "host": ["{{baseUrl}}"], "path": ["gares-routieres"] }
      }
    },
    {
      "name": "3. Créer Coopérative",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('coopId', json.id);",
              "  console.log('✅ coopId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Cooperative Kofmad\",\n  \"telephone\": \"0341111111\",\n  \"email\": \"kofmad@test.mg\",\n  \"siegeSocial\": \"Antananarivo\",\n  \"gareRoutiereId\": \"{{gareId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/cooperatives", "host": ["{{baseUrl}}"], "path": ["cooperatives"] }
      }
    },
    {
      "name": "4. Créer Classe (économique)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('classeId', json.id);",
              "  console.log('✅ classeId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"economique\",\n  \"description\": \"Classe standard\",\n  \"coefficientPrix\": 1\n}"
        },
        "url": { "raw": "{{baseUrl}}/classes", "host": ["{{baseUrl}}"], "path": ["classes"] }
      }
    },
    {
      "name": "5. Créer Voiture",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('voitureId', json.id);",
              "  console.log('✅ voitureId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"matricule\": \"AB-123-CD\",\n  \"nom\": \"Mercedes Sprinter\",\n  \"capacite\": 18,\n  \"anneeFabrication\": 2022,\n  \"marque\": \"Mercedes\",\n  \"modele\": \"Sprinter\",\n  \"etat\": \"disponible\",\n  \"cooperativeId\": \"{{coopId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/voitures", "host": ["{{baseUrl}}"], "path": ["voitures"] }
      }
    },
    {
      "name": "6. Créer Chauffeur",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('chauffeurId', json.id);",
              "  console.log('✅ chauffeurId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nom\": \"Rakoto\",\n  \"prenom\": \"Jean\",\n  \"telephone\": \"0349999999\",\n  \"email\": \"jean.rakoto@test.mg\",\n  \"numeroPermis\": \"PERMIS-12345\",\n  \"statut\": \"actif\",\n  \"voitureId\": \"{{voitureId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/chauffeurs", "host": ["{{baseUrl}}"], "path": ["chauffeurs"] }
      }
    },
    {
      "name": "7. Créer Voyage (Tana → Toamasina) 🔐",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('voyageId', json.id);",
              "  console.log('✅ voyageId =', json.id);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateDepart\": \"2026-05-25\",\n  \"heureDepart\": \"06:00\",\n  \"dateArrivee\": \"2026-05-25\",\n  \"heureArrivee\": \"14:00\",\n  \"localisationDepart\": \"Gare d'Ambodivona, Antananarivo\",\n  \"localisationArrivee\": \"Gare de Toamasina\",\n  \"villeDepart\": \"Antananarivo\",\n  \"villeArrivee\": \"Toamasina\",\n  \"prix\": 35000,\n  \"dureeEstimee\": \"8h\",\n  \"latitudeDepart\": -18.9098,\n  \"longitudeDepart\": 47.5219,\n  \"latitudeArrivee\": -18.1492,\n  \"longitudeArrivee\": 49.4023,\n  \"distanceKm\": 372,\n  \"voitureId\": \"{{voitureId}}\",\n  \"classeId\": \"{{classeId}}\",\n  \"chauffeurId\": \"{{chauffeurId}}\",\n  \"cooperativeId\": \"{{coopId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/voyages", "host": ["{{baseUrl}}"], "path": ["voyages"] }
      }
    },
    {
      "name": "8. (Bonus) Créer 2e voyage (Tana → Fianarantsoa)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateDepart\": \"2026-05-25\",\n  \"heureDepart\": \"07:30\",\n  \"dateArrivee\": \"2026-05-25\",\n  \"heureArrivee\": \"16:00\",\n  \"localisationDepart\": \"Gare d'Ambodivona, Antananarivo\",\n  \"localisationArrivee\": \"Gare de Fianarantsoa\",\n  \"villeDepart\": \"Antananarivo\",\n  \"villeArrivee\": \"Fianarantsoa\",\n  \"prix\": 45000,\n  \"dureeEstimee\": \"8h30\",\n  \"latitudeDepart\": -18.9098,\n  \"longitudeDepart\": 47.5219,\n  \"latitudeArrivee\": -21.4536,\n  \"longitudeArrivee\": 47.0854,\n  \"distanceKm\": 412,\n  \"voitureId\": \"{{voitureId}}\",\n  \"classeId\": \"{{classeId}}\",\n  \"chauffeurId\": \"{{chauffeurId}}\",\n  \"cooperativeId\": \"{{coopId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/voyages", "host": ["{{baseUrl}}"], "path": ["voyages"] }
      }
    },
    {
      "name": "9. Rechercher voyages (ce que fait l'app) 🔐",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/voyages/search?depart=Antananarivo&arrivee=Toamasina&date=2026-05-25",
          "host": ["{{baseUrl}}"],
          "path": ["voyages", "search"],
          "query": [
            { "key": "depart", "value": "Antananarivo" },
            { "key": "arrivee", "value": "Toamasina" },
            { "key": "date", "value": "2026-05-25" }
          ]
        }
      }
    },
    {
      "name": "10. Voir le seat map 🔐",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/voyages/{{voyageId}}/seat-map",
          "host": ["{{baseUrl}}"],
          "path": ["voyages", "{{voyageId}}", "seat-map"]
        }
      }
    },
    {
      "name": "11. Créer une réservation (place 5) 🔐",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.id) {",
              "  pm.collectionVariables.set('reservationId', json.id);",
              "  console.log('✅ reservationId =', json.id);",
              "  console.log('Code confirmation:', json.codeConfirmation);",
              "}",
              "pm.test('Created', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"voyageId\": \"{{voyageId}}\",\n  \"numPlace\": 5\n}"
        },
        "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
      }
    },
    {
      "name": "12. Payer la réservation (wallet) 🔐",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"wallet\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/reservations/{{reservationId}}/pay",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "{{reservationId}}", "pay"]
        }
      }
    },
    {
      "name": "13. Lister mes réservations 🔐",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": { "raw": "{{baseUrl}}/reservations/me", "host": ["{{baseUrl}}"], "path": ["reservations", "me"] }
      }
    },
    {
      "name": "14. (Bonus) Annuler une réservation 🔐",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/reservations/{{reservationId}}/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["reservations", "{{reservationId}}", "cancel"]
        }
      }
    }
  ]
}
